# ============================================================
# HOMELAB ENVIRONMENT TEMPLATE
#
# Copy this file to .env and replace the example values with
# values appropriate for your environment.
#
# .env is intentionally excluded from version control.
# ============================================================


# ============================================================
# GLOBAL SETTINGS
# ============================================================

HOMELAB_DATA=/srv/homelab-data
TZ=Etc/UTC


# ============================================================
# BACKEND HOSTS
#
# 192.0.2.0/24 is reserved for documentation/examples.
# ============================================================

PI_LOCAL_HOST=127.0.0.1
AI_SERVER_HOST=192.168.0.1
PROXMOX_HOST=192.168.0.1
TNAS_HOST=192.168.0.1


# ============================================================
# RASPBERRY PI - LOCAL SERVICES
# ============================================================

PIHOLE_URL=dns.example.internal
PIHOLE_PORT=8000

BITWARDEN_URL=vault.example.internal
BITWARDEN_PORT=8000

GLANCE_URL=dashboard.example.internal
GLANCE_PORT=8000

UPTIME_URL=uptime.example.internal
UPTIME_PORT=8000

ACTUAL_URL=budget.example.internal
ACTUAL_PORT=8000

PI_COCKPIT_URL=pi-admin.example.internal
PI_COCKPIT_PORT=8000


# ============================================================
# AI SERVER
# ============================================================

SILLYTAVERN_URL=chat.example.internal
SILLYTAVERN_PORT=8000

OPENWEBUI_URL=llm.example.internal
OPENWEBUI_PORT=8000

CHATTERBOX_URL=voice.example.internal
CHATTERBOX_API_PORT=8000
CHATTERBOX_WEB_PORT=8000

UBUNTU_COCKPIT_URL=server-admin.example.internal
UBUNTU_COCKPIT_PORT=8000

INVOKEAI_URL=images.example.internal
INVOKEAI_PORT=8000


# ============================================================
# PROXMOX
# ============================================================

PVE_URL=virtualization.example.internal
PVE_PORT=8000


# ============================================================
# NAS
# ============================================================

TNAS_URL=nas.example.internal
TNAS_HTTPS_PORT=8000

JELLYFIN_URL=media.example.internal

PAPERLESS_URL=documents.example.internal
PAPERLESS_PORT=8000

KAVITA_URL=library.example.internal
KAVITA_PORT=8000
