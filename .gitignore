# --- Secrets / machine-local config ---
.env
**/*.env
**/settings.env

# Allow safe examples to be committed
!**/*.env.example
!**/settings.env.example

# --- Local persistent state / databases (do not commit) ---
backups/

# Pi-hole state (big + constantly changing)
stacks/pihole/etc-pihole/

# Common service data dirs (if they ever appear)
**/data/
**/db/
**/bwdata/
**/bitwarden-data/

